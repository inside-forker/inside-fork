# Copy to .env.local (or .env) and fill in values.
# PayFast is required for checkout/payment — copy live or sandbox creds from Vercel.

DATABASE_URL=
JWT_SECRET=
TICKET_SIGNING_SECRET=

# PayFast / GoPayFast (Pakistan — Apps.net.pk)
# UAT (testing — merchant 102 / key from PayFast):
PAYFAST_TOKEN_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_TRANSACTION_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
PAYFAST_USE_SANDBOX=true
# LIVE (production — use live merchant credentials, never merchant 102):
# PAYFAST_TOKEN_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
# PAYFAST_TRANSACTION_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
# PAYFAST_USE_SANDBOX=false
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MERCHANT_NAME=
# PAYFAST_STORE_ID=
# Public site origin — used to build CHECKOUT_URL (IPN), SUCCESS_URL, FAILURE_URL.
# For local IPN testing, point this at an ngrok/tunnel URL PayFast can reach.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_PAYFAST_SUCCESS_URL=
# NEXT_PUBLIC_PAYFAST_FAILURE_URL=

# Google reCAPTCHA v3 (signup, contact, newsletter, membership, get-listed)
# Site key is public; secret stays server-only. Both are required in production.
# NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
# RECAPTCHA_V3_SITE_KEY=   # optional alias if the public var was not present at build time
# RECAPTCHA_V3_SECRET_KEY=

# Crisp live chat (support widget on public pages). Website ID from
# Crisp → Settings → Website Settings → Setup instructions. Unset = no widget.
# NEXT_PUBLIC_CRISP_WEBSITE_ID
